PORT=3000
CORS_ORIGIN=http://localhost:5173

# docker compose up -d postgres (see docker-compose.yml at repo root)
DATABASE_URL=postgresql://quiz:quiz@localhost:5432/quiz

# any long random string in dev; use a real secret in production
JWT_SECRET=dev-secret-change-me

# S3-compatible bucket for uploaded tracks/posters (Cloudflare R2, AWS S3, ...)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# public base URL tracks/posters are served from (bucket public URL or CDN in front of it)
S3_PUBLIC_URL=
